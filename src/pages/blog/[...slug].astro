---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts
        .filter(p => !p.slug.startsWith('articulo-ejemplo'))
        .map(post => ({
            params: { slug: post.slug },
            props: { post },
        }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await post.render();

const url = `https://chileelectrico.cl/blog/${post.slug}`;

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "author": { "@type": "Organization", "name": post.data.author },
    "publisher": { "@type": "Organization", "name": "ChileEléctrico", "url": "https://chileelectrico.cl" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": url },
    "url": url,
    "image": post.data.image,
    "inLanguage": "es-CL"
};
---

<Layout
    title={`${post.data.title} | ChileEléctrico`}
    description={post.data.description}
    image={post.data.image}
    schema={articleSchema}
>
    <article class="py-16 px-6 bg-white">
        <div class="container mx-auto max-w-3xl">
            <nav class="text-sm text-slate-500 mb-6">
                <a href="/" class="hover:text-blue-600">Inicio</a> ›
                <a href="/blog/" class="hover:text-blue-600">Blog</a> ›
                <span class="text-slate-700">{post.data.title}</span>
            </nav>

            <header class="mb-10">
                <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.map(tag => (
                        <span class="bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">{tag}</span>
                    ))}
                </div>
                <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight">{post.data.title}</h1>
                <div class="flex items-center gap-4 text-slate-500 text-sm mt-6">
                    <span>{post.data.pubDate.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    <span>·</span>
                    <span>{post.data.author}</span>
                </div>
            </header>

            {post.data.image && (
                <img src={post.data.image} alt={post.data.title} class="w-full h-72 md:h-96 object-cover rounded-2xl mb-10" loading="lazy" />
            )}

            <div class="prose prose-lg max-w-none prose-headings:text-slate-900 prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 prose-p:text-slate-700 prose-p:leading-relaxed prose-a:text-amber-600 prose-a:font-semibold prose-a:underline prose-strong:text-slate-900 prose-li:my-1 prose-table:border prose-th:bg-slate-100 prose-th:p-3 prose-td:p-3 prose-td:border">
                <Content />
            </div>

            <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-10 mt-16 text-center">
                <h3 class="text-2xl md:text-3xl font-extrabold mb-3">¿Necesitas asesoría eléctrica?</h3>
                <p class="text-slate-300 mb-6">Auditorías SEC, instalación industrial y residencial en Región Metropolitana.</p>
                <a href="/cotizar/" class="inline-block bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold px-8 py-4 rounded-xl transition">Cotizar mi proyecto →</a>
            </div>
        </div>
    </article>
</Layout>
