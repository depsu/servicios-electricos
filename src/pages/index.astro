---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import CallToAction from '../components/CallToAction.astro';
import { comunas } from '../data/comunas';
import { Image } from 'astro:assets';
import imgHero from '../assets/paginas/home-hero.png';
import imgTerreno from '../assets/paginas/cobertura-terreno.png';
import SeccionesSeo from '../components/SeccionesSeo.astro';
import { seoPaginas } from '../data/seo-paginas';

const seo = seoPaginas['portada'] ?? {};

// Agrupación de cobertura: se muestran TODAS las comunas para que
// ninguna página de cobertura quede huérfana a dos clics de la home.
// Grupos por dónde queda la comuna, no por su tipo de cliente: con las comunas urbanas
// nuevas, "Zona Norte y Rural" y "Zona Sur Poniente" ya no calzaban.
const grupos = [
  { titulo: 'Polos industriales', color: 'bg-blue-600', hover: 'hover:bg-blue-50 hover:text-blue-700',
    slugs: ['lampa-valle-grande', 'pudahuel-enea-lo-boza', 'san-bernardo'] },
  { titulo: 'Parcelas y sectores rurales', color: 'bg-emerald-500', hover: 'hover:bg-emerald-50 hover:text-emerald-700',
    slugs: ['chicureo-colina', 'buin', 'paine', 'melipilla', 'talagante', 'penaflor'] },
  { titulo: 'Sector oriente', color: 'bg-violet-500', hover: 'hover:bg-violet-50 hover:text-violet-700',
    slugs: ['las-condes-vitacura', 'lo-barnechea-la-dehesa', 'providencia', 'nunoa', 'la-reina', 'penalolen'] },
  { titulo: 'Sur de Santiago', color: 'bg-amber-500', hover: 'hover:bg-amber-50 hover:text-amber-700',
    slugs: ['la-florida', 'san-miguel'] },
].map((g) => ({ ...g, comunas: g.slugs.map((sl) => comunas.find((c) => c.slug === sl)).filter((c) => c !== undefined) }));
// Ninguna comuna del catálogo puede quedar fuera de la portada (sería una página sin enlace).
const sinGrupo = comunas.filter((c) => !grupos.some((g) => g.slugs.includes(c.slug)));
if (sinGrupo.length) throw new Error('Comunas sin grupo en la portada: ' + sinGrupo.map((c) => c.slug).join(', '));
---

<Layout
  title={seo.metaTitle ?? "Servicios Eléctricos RM | Electricistas Certificados SEC"}
  description={seo.metaDescription ?? "Electricistas certificados SEC en toda la Región Metropolitana, para tu casa o para tu empresa. Cuéntanos qué necesitas y te cotizamos antes de empezar el trabajo."}
>
  
  <!-- Hero Split -->
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 to-slate-800 opacity-90"></div>
      <Image
        src={imgHero}
        alt="Electricista trabajando en un tablero eléctrico industrial abierto, con guantes aislantes y casco"
        widths={[640, 1024, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover opacity-20"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="container mx-auto px-4 py-20 relative z-10">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
          Servicios Eléctricos en la <span class="text-amber-400">Región Metropolitana</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 mb-8">
          Especialistas certificados SEC para proyectos industriales y servicios domiciliarios.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- B2B Card -->
        <a href="/empresas-industria/" class="group relative overflow-hidden rounded-2xl bg-white p-1 transition-transform hover:-translate-y-1 hover:shadow-2xl">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-600 to-indigo-700 opacity-10 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative h-full bg-slate-50 rounded-xl p-8 flex flex-col items-center text-center group-hover:bg-transparent transition-colors duration-300">
            <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-6 text-3xl group-hover:bg-white/20 group-hover:text-white transition-colors">
              🏭
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-white">Empresas e Industria</h2>
            <p class="text-slate-600 mb-6 group-hover:text-blue-100">
              Montaje de tableros, escalerillas, iluminación industrial y corrientes débiles. Cumplimiento normativo y seguridad.
            </p>
            <span class="mt-auto px-6 py-3 bg-blue-600 text-white font-bold rounded-lg group-hover:bg-white group-hover:text-blue-700 w-full md:w-auto">
              Ver Soluciones Industriales
            </span>
          </div>
        </a>

        <!-- B2C Card -->
        <a href="/hogar-condominios/" class="group relative overflow-hidden rounded-2xl bg-white p-1 transition-transform hover:-translate-y-1 hover:shadow-2xl">
          <div class="absolute inset-0 bg-gradient-to-br from-teal-500 to-emerald-600 opacity-10 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative h-full bg-slate-50 rounded-xl p-8 flex flex-col items-center text-center group-hover:bg-transparent transition-colors duration-300">
            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6 text-3xl group-hover:bg-white/20 group-hover:text-white transition-colors">
              🏡
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-white">Hogar y Condominios</h2>
            <p class="text-slate-600 mb-6 group-hover:text-emerald-100">
              Electricidad, empalmes rurales, gasfitería y pintura. Atención rápida, limpia y garantizada.
            </p>
            <span class="mt-auto px-6 py-3 bg-emerald-600 text-white font-bold rounded-lg group-hover:bg-white group-hover:text-emerald-700 w-full md:w-auto">
              Ver Servicios Hogar
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Services Quick View -->
  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900">Nuestros Servicios Principales</h2>
        <p class="text-slate-600 mt-2">Cubrimos todas las necesidades eléctricas y de mantenimiento</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Industrial Items -->
        {['Tableros Eléctricos', 'Escalerillas y Bandejas', 'Iluminación LED', 'Corrientes Débiles'].map(item => (
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-100 flex items-start gap-4">
            <div class="text-blue-600 mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900">{item}</h3>
              <p class="text-xs text-blue-600 font-semibold uppercase mt-1">Industrial</p>
            </div>
          </div>
        ))}
        
        <!-- Hogar Items -->
        {['Empalmes Rurales', 'Gasfitería', 'Pintura Fachadas', 'Urgencias 24/7'].map(item => (
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-100 flex items-start gap-4">
            <div class="text-emerald-600 mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900">{item}</h3>
              <p class="text-xs text-emerald-700 font-semibold uppercase mt-1">Hogar</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-blue-600 font-semibold tracking-wider text-sm">COBERTURA RM</span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-6">
            Llegamos donde su proyecto nos necesite
          </h2>
          <p class="text-slate-600 mb-8 text-lg">
            Contamos con cuadrillas móviles estratégicamente ubicadas para asegurar tiempos de respuesta rápidos en zonas industriales, parcelas y comunas residenciales de Santiago.
          </p>
          
          <div class="space-y-6">
            {grupos.map((g) => (
            <div>
              <h3 class="font-bold text-slate-900 mb-2 flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full ${g.color}`}></span>
                {g.titulo}
              </h3>
              <div class="flex flex-wrap gap-2">
                {g.comunas.map((comuna) => (
                  <a href={`/cobertura/${comuna!.slug}/`} class={`px-3 min-h-11 inline-flex items-center bg-slate-100 text-slate-600 rounded-full text-sm transition-colors ${g.hover}`}>
                    {comuna!.name}
                  </a>
                ))}
              </div>
            </div>
            ))}

            <div>
              <a href="/cobertura/" class="inline-flex items-center gap-2 min-h-11 text-blue-600 font-semibold hover:underline">
                Ver todas las zonas de cobertura
              </a>
            </div>
          </div>
        </div>
        <div class="relative">
             <Image
              src={imgTerreno}
              alt="Camioneta de servicio eléctrico en un camino de la periferia de Santiago, junto a postes del tendido"
              widths={[640, 1024]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="rounded-2xl shadow-xl z-10 relative"
              loading="lazy"
            />
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-blue-100 rounded-full -z-0 opacity-50 blur-2xl"></div>
        </div>
      </div>
    </div>
  </section>

  <SeccionesSeo secciones={seo.seoSections} fondo="blanco" />

  <ProjectsGrid />

  <CallToAction 
    title="¿Listo para comenzar?"
    subtitle="Cotiza tu proyecto industrial o servicio domiciliario hoy mismo."
    ctaText="Solicitar Cotización"
    ctaLink="/cotizar/"
  />
</Layout>
