---
// Preguntas frecuentes simples (lista) para páginas que no usan la plantilla de servicio.
// Las respuestas aceptan enlaces internos [texto](/ruta/).
import { enlazar } from '../lib/enlazar';
interface Props { items?: { question: string; answer: string }[]; titulo?: string }
const { items = [], titulo = 'Preguntas frecuentes' } = Astro.props;
---
{items.length > 0 && (
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-3xl font-bold text-center text-slate-900 mb-10">{titulo}</h2>
      <div class="space-y-4">
        {items.map((it) => (
          <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
            <h3 class="font-bold text-slate-900 mb-2 text-lg">{it.question}</h3>
            <p class="text-slate-700" set:html={enlazar(it.answer)} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}
