---
interface FAQItem {
    question: string;
    answer: string;
}

interface FAQGroup {
    title: string;
    items: FAQItem[];
}

interface Props {
    title?: string;
    items?: FAQItem[];
    // Preguntas por tema. Van dentro de UN solo FAQPage: declarar varios en la
    // misma página es un error en Search Console, no un extra.
    groups?: FAQGroup[];
}

const { title = "Preguntas Frecuentes", items, groups } = Astro.props;

const bloques: FAQGroup[] = groups ?? [{ title: '', items: items ?? [] }];

// Numeración continua entre bloques: los id de cada panel deben ser únicos en
// toda la página, no dentro de su grupo.
let contador = 0;
const bloquesConIndice = bloques.map(bloque => ({
    title: bloque.title,
    items: bloque.items.map(item => ({ ...item, index: contador++ })),
}));
---

<section class="py-16 bg-white" itemscope itemtype="https://schema.org/FAQPage">
    <div class="container mx-auto px-4 max-w-3xl">
        {title && <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">{title}</h2>}

        <div class="flex flex-col gap-12">
            {bloquesConIndice.map(bloque => (
                <div>
                    {bloque.title && (
                        <h3 class="text-sm font-bold uppercase tracking-widest text-blue-700 mb-5 pb-3 border-b border-slate-200">
                            {bloque.title}
                        </h3>
                    )}
                    <div class="space-y-4">
                        {bloque.items.map(item => (
                            <div class="border border-slate-200 rounded-xl overflow-hidden" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                                <button
                                    class="w-full flex items-center justify-between p-5 bg-slate-50 hover:bg-slate-100 transition-colors text-left group"
                                    aria-expanded="false"
                                    aria-controls={`faq-${item.index}`}
                                    onclick={`toggleFaq('faq-${item.index}')`}
                                >
                                    <span class="font-bold text-slate-800 text-lg pr-4" itemprop="name">{item.question}</span>
                                    <i class="fa-solid fa-chevron-down text-slate-600 group-hover:text-blue-600 transition-transform duration-300" id={`icon-faq-${item.index}`}></i>
                                </button>
                                <div id={`faq-${item.index}`} class="hidden bg-white p-5 border-t border-slate-100 text-slate-600 leading-relaxed" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                                    <div itemprop="text" set:html={item.answer}></div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script is:inline>
    function toggleFaq(id) {
        const content = document.getElementById(id);
        const icon = document.getElementById('icon-' + id);
        const boton = document.querySelector('[aria-controls="' + id + '"]');

        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
            if (boton) boton.setAttribute('aria-expanded', 'true');
        } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
            if (boton) boton.setAttribute('aria-expanded', 'false');
        }
    }
</script>
