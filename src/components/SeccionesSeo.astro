---
// Secciones de texto propias de una página (H2 + párrafos). Los párrafos aceptan enlaces
// internos [texto](/ruta/), que enlazar() convierte a HTML escapando todo lo demás.
import { enlazar } from '../lib/enlazar';

interface Props {
  secciones?: { h2: string; paragraphs: string[] }[];
  fondo?: 'claro' | 'blanco';
}
const { secciones = [], fondo = 'claro' } = Astro.props;
---
{secciones.length > 0 && (
  <section class={`py-16 ${fondo === 'claro' ? 'bg-slate-50 border-y border-slate-200' : 'bg-white'}`}>
    <div class="container mx-auto px-4 max-w-3xl">
      {secciones.map((sec) => (
        <div class="mb-12 last:mb-0">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-5">{sec.h2}</h2>
          {sec.paragraphs.map((p) => (
            <p class="text-lg leading-relaxed text-slate-700 mb-4" set:html={enlazar(p)} />
          ))}
        </div>
      ))}
    </div>
  </section>
)}
