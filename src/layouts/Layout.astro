---
import '../styles/global.css';
import { comunas } from '../data/comunas';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { siteConfig } from '../config/site';

interface Props {
	title: string;
    description?: string;
    image?: string;
    schema?: object;
    regionText?: string;
    noIndex?: boolean;
}

const { title, description = "Servicios eléctricos profesionales en Región Metropolitana. Industrial y Domiciliario.", image = "/images/og-default.jpg", schema, regionText = "Región Metropolitana", noIndex = false } = Astro.props;
const { font } = siteConfig.theme;

// URL canónica normalizada: siempre con barra final y sin query,
// para que /nosotros y /nosotros/ apunten a la misma URL que el sitemap.
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;

// Map fonts to Google Fonts URLs and Tailwind classes
const fontConfig = {
    sans: {
        url: 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap',
        family: 'font-sans' // Tailwind default sans (Inter/System)
    },
    serif: {
        url: 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap',
        family: 'font-serif'
    },
    mono: {
        url: 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap',
        family: 'font-mono'
    }
};

const currentFont = fontConfig[font] || fontConfig.sans;

import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<!-- Google Tag Manager, con carga diferida: el contenedor (y lo que trae, como Clarity y
		     el pixel de Bing) se pide cuando la página ya terminó de cargar, en un momento libre
		     del navegador. Antes competía con el primer dibujo y el LCP móvil de la portada
		     variaba entre 2 y 10 s según qué tan rápido respondían esos terceros (28-sep-2026).
		     El dataLayer existe desde el inicio, así que los eventos anteriores quedan en cola. -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});function cargar(){if(w.__gtmCargado)return;w.__gtmCargado=1;
		var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
		j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);}
		function agendar(){if('requestIdleCallback' in w){w.requestIdleCallback(cargar,{timeout:3000});}else{w.setTimeout(cargar,1500);}}
		if(d.readyState==='complete'){agendar();}else{w.addEventListener('load',agendar,{once:true});}
		})(window,document,'script','dataLayer','GTM-NQ44WHJ3');</script>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Robots -->
        <!-- Robots -->
        {noIndex 
            ? <meta name="robots" content="noindex, nofollow" />
            : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        }

        <!-- Geo Meta Tags (Chile) -->
        <meta name="geo.region" content="CL-RM" />
        <meta name="geo.placename" content="Santiago, Región Metropolitana" />
        <meta name="geo.position" content="-33.4489;-70.6693" />
        <meta name="ICBM" content="-33.4489, -70.6693" />

        <!-- Author & Publisher -->
        <meta name="author" content="Servicios Eléctricos RM" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, canonicalURL)} />
        <meta property="og:locale" content="es_CL" />
        <meta property="og:site_name" content="Servicios Eléctricos RM" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, canonicalURL)} />
        
        <!-- Page-specific Schema -->
        {schema && (
            <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        )}

        <!-- Global LocalBusiness Schema -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Electrician",
            "name": "Servicios Eléctricos RM",
            "description": "Servicios eléctricos industriales y domiciliarios en la Región Metropolitana. Tableros eléctricos, empalmes rurales, gasfitería y más.",
            "url": "https://chileelectrico.cl",
            "telephone": "+56930153632",
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Santiago",
                "addressRegion": "Región Metropolitana",
                "addressCountry": "CL"
            },
            // Sin "geo": eran las coordenadas genéricas del centro de Santiago, no un local del
            // negocio. Las zonas atendidas salen del mismo catálogo que genera /cobertura/.
            "areaServed": [
                { "@type": "AdministrativeArea", "name": "Región Metropolitana de Santiago" },
                ...comunas.map((c) => ({ "@type": "Place", "name": c.name }))
            ],
            "priceRange": "$$",
            "openingHoursSpecification": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                "opens": "00:00",
                "closes": "23:59"
            },
            "sameAs": []
        })} />
        
        <!-- Sin Google Fonts: la hoja de Inter bloqueaba el primer dibujo de la página y la fuente
             nunca se aplicaba (font-sans de Tailwind es la pila del sistema). Medido 28-sep-2026:
             el LCP móvil de la portada era el H1 esperando esa hoja. -->
        <!-- Íconos: la hoja de Font Awesome se carga sin bloquear el dibujo (media=print y
             luego all). Los íconos aparecen un instante después; el texto no los espera. -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
        <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
        <ClientRouter />
	</head>
	<body class={`bg-slate-50 antialiased pb-24 md:pb-0 ${currentFont.family}`}>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NQ44WHJ3"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) test -->
        <Navbar>{regionText}</Navbar>
		<slot />
        <Footer />
        <WhatsAppFloat transition:persist />
        <StickyCTA transition:persist />
        <script is:inline>
            document.addEventListener('astro:page-load', () => {
                let lastScroll = 0;
                const navs = [document.getElementById('main-nav'), document.getElementById('service-nav')].filter(Boolean);
                if (navs.length === 0) return;

                window.addEventListener('scroll', () => {
                    const currentScroll = window.scrollY;
                    if (window.innerWidth < 1024) {
                        if (currentScroll <= 0) {
                            navs.forEach(nav => nav.classList.remove('-translate-y-full'));
                            return;
                        }
                        if (currentScroll > lastScroll && currentScroll > 60) {
                            navs.forEach(nav => nav.classList.add('-translate-y-full'));
                        } else if (currentScroll < lastScroll) {
                            navs.forEach(nav => nav.classList.remove('-translate-y-full'));
                        }
                    } else {
                        navs.forEach(nav => nav.classList.remove('-translate-y-full'));
                    }
                    lastScroll = currentScroll;
                }, { passive: true });
            });
        </script>
	</body>
</html>
